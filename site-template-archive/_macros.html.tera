{# Ordinary children form one column to the right. A spatial group's children
   instead live inside its own board, using authored coordinates relative to
   that group. The row is the positioned object; the paper remains in flow. #}
{% macro node(n, spatial) -%}
<div class="node-row{% if spatial and n.authored_position %} spatial-item{% elif n.position and n.depth > 0 %} authored-item{% endif %}"
     {% if spatial and n.authored_position %}style="left:{{ n.authored_position.x }}px; top:{{ n.authored_position.y }}px;"
     {% elif n.position and n.depth > 0 %}style="left:{{ n.position.x }}px; top:{{ n.position.y }}px;"{% endif %}>
  {% if n.foldable %}
  <details class="node type-{{ n.node_type }}{% if n.node_type == "group" %} group-sheet{% endif %}{% if n.spatial_children and n.node_type == "group" %} spatial-group{% endif %}"
           id="node-{{ n.id }}" data-depth="{{ n.depth }}"
           {% if not n.folded %}open{% endif %}
           {% if spatial and n.authored_position %}style="width:{{ n.authored_position.width }}px; height:{{ n.authored_position.height }}px;{% if n.color is defined %} --accent:{{ n.color }};{% endif %}"
           {% elif n.position and n.depth > 0 %}style="width:{{ n.position.width }}px; height:{{ n.position.height }}px;{% if n.color is defined %} --accent:{{ n.color }};{% endif %}"
           {% elif n.color is defined %}style="--accent:{{ n.color }};"{% endif %}>
    <summary class="node-title"><span class="node-title-text">{{ n.title }}</span></summary>
    {% if n.tags %}<div class="node-tags">{% for t in n.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
    {% if n.node_type == "group" and n.spatial_children %}
    <div class="group-canvas">{% for child in n.children %}{{ self::node(n=child, spatial=true) }}{% endfor %}</div>
    {% elif n.node_type != "group" %}<div class="node-body">{{ n.html_body | safe }}</div>{% endif %}
  </details>
  {% else %}
  <div class="node type-{{ n.node_type }}" id="node-{{ n.id }}" data-depth="{{ n.depth }}"
       {% if spatial and n.authored_position %}style="width:{{ n.authored_position.width }}px; height:{{ n.authored_position.height }}px;{% if n.color is defined %} --accent:{{ n.color }};{% endif %}"
       {% elif n.position and n.depth > 0 %}style="width:{{ n.position.width }}px; height:{{ n.position.height }}px;{% if n.color is defined %} --accent:{{ n.color }};{% endif %}"
       {% elif n.color is defined %}style="--accent:{{ n.color }};"{% endif %}>
    <div class="node-title"><span class="node-title-text">{{ n.title }}</span></div>
    {% if n.tags %}<div class="node-tags">{% for t in n.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
    {% if n.node_type != "group" %}<div class="node-body">{{ n.html_body | safe }}</div>{% endif %}
  </div>
  {% endif %}
  {% if n.children and n.node_type != "group" or n.children and not n.spatial_children %}
  <div class="node-children{% if n.depth == 0 %} root-children{% endif %}" data-parent-depth="{{ n.depth }}">{% for child in n.children %}{{ self::node(n=child, spatial=false) }}{% endfor %}</div>
  {% endif %}
</div>
{%- endmacro node %}
