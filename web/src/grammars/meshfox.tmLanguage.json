{
  "name": "meshfox",
  "scopeName": "markup.meshfox.injection",
  "injectTo": ["text.html.markdown"],
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#meshfox-comment" }],
  "repository": {
    "meshfox-comment": {
      "begin": "(<!--)\\s*(/)?(meshfox:[\\w-]+)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.comment.meshfox" },
        "2": { "name": "punctuation.definition.tag.end.meshfox" },
        "3": { "name": "keyword.other.meshfox" }
      },
      "end": "(-->)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.comment.meshfox" }
      },
      "name": "comment.block.meshfox",
      "patterns": [{ "include": "#meshfox-attr" }]
    },
    "meshfox-attr": {
      "match": "([\\w-]+)(=(?:\"[^\"]*\"|'[^']*'|[^\\s`>]*))?",
      "captures": {
        "1": { "name": "entity.other.attribute-name.meshfox" },
        "2": { "name": "string.unquoted.meshfox" }
      }
    }
  }
}
