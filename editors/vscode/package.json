{
  "name": "meshfox-vscode",
  "displayName": "meshfox",
  "description": "View and run meshfox .canvas.md files as an interactive node canvas, right inside VS Code.",
  "version": "0.2.0",
  "publisher": "Orofarne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orofarne/meshfox",
    "directory": "editors/vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks",
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "meshfox.canvasEditor",
        "displayName": "meshfox canvas",
        "selector": [
          {
            "filenamePattern": "*.canvas.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "meshfox.canvasEditorAny",
        "displayName": "meshfox canvas",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "meshfox.openAsCanvas",
        "title": "Open as meshfox canvas",
        "category": "meshfox"
      },
      {
        "command": "meshfox.install",
        "title": "Install",
        "category": "meshfox"
      },
      {
        "command": "meshfox.checkForUpdates",
        "title": "Check for Updates",
        "category": "meshfox"
      },
      {
        "command": "meshfox.openInBrowser",
        "title": "Open in Browser",
        "category": "meshfox",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "meshfox.openAsCanvas",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "meshfox.openInBrowser",
          "when": "activeCustomEditorId == meshfox.canvasEditor || activeCustomEditorId == meshfox.canvasEditorAny",
          "group": "navigation"
        }
      ]
    },
    "grammars": [
      {
        "scopeName": "meshfox.marker.injection",
        "path": "./syntaxes/meshfox-marker.injection.json",
        "injectTo": ["text.html.markdown"]
      }
    ],
    "configuration": {
      "title": "meshfox",
      "properties": {
        "meshfox.executablePath": {
          "type": "string",
          "default": "meshfox",
          "description": "Path to the meshfox binary. Left as \"meshfox\" (the default), it's resolved from PATH first, then a couple of common install locations (~/.local/bin, /opt/homebrew/bin, /usr/local/bin) if that fails. Set an absolute path here to override both and use that exact binary."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
