{% import "_document_macros.html.tera" as m %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ site.title }}</title>
<style>
@font-face {
  font-family: "Fira Code";
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url(fonts/fira-code-latin-400-normal.woff2) format("woff2");
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
  font-family: "Fira Code";
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url(fonts/fira-code-cyrillic-400-normal.woff2) format("woff2");
  unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;
}
@font-face {
  font-family: "Fira Code";
  font-style: normal;
  font-display: swap;
  font-weight: 700;
  src: url(fonts/fira-code-latin-700-normal.woff2) format("woff2");
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
  font-family: "Fira Code";
  font-style: normal;
  font-display: swap;
  font-weight: 700;
  src: url(fonts/fira-code-cyrillic-700-normal.woff2) format("woff2");
  unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;
}
@page { size: a4; margin: 2cm; }
* { box-sizing: border-box; }
body {
  font-family: "Fira Code", system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: 10.5pt;
  line-height: 1.5;
  color: #1a1a1a;
  margin: 0;
}
.doc-header { text-align: center; margin-bottom: 24pt; }
.doc-header h1 { font-size: 22pt; margin: 0; }
.node { margin: 0 0 12pt; page-break-inside: avoid; }
.node-title { font-weight: 700; break-after: avoid; }
.node-title.depth-0 { font-size: 20pt; margin: 0 0 8pt; }
.node-title.depth-1 { font-size: 16pt; margin: 16pt 0 6pt; }
.node-title.depth-2 { font-size: 13.5pt; margin: 12pt 0 5pt; }
.node-title.depth-3 { font-size: 12pt; margin: 10pt 0 4pt; }
.node-title.depth-4 { font-size: 11pt; margin: 8pt 0 4pt; }
.node-title.depth-5,
.node-title.depth-6 { font-size: 10.5pt; margin: 6pt 0 3pt; }
.node-tags { margin: 0 0 4pt; }
.tag {
  display: inline-block;
  font-size: 7pt;
  color: #767676;
  border: 0.5pt solid #ccc;
  border-radius: 3pt;
  padding: 1pt 5pt;
  margin: 0 4pt 4pt 0;
}
.node-target { font-size: 8.5pt; color: #767676; margin: 0 0 6pt; word-break: break-all; }
.node-body { page-break-inside: auto; }
.node-body p { margin: 0 0 8pt; }
.node-body img { max-width: 100%; }
.node-body pre {
  background: #f4f4f4;
  border: 0.5pt solid #ddd;
  border-radius: 3pt;
  padding: 6pt 8pt;
  font-size: 8.5pt;
  white-space: pre-wrap;
  word-break: break-word;
  page-break-inside: avoid;
}
.node-body code { font-family: "Fira Code", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.node-body table { border-collapse: collapse; width: 100%; margin: 0 0 8pt; font-size: 9pt; }
.node-body th, .node-body td { border: 0.5pt solid #ccc; padding: 3pt 6pt; text-align: left; }
.node-children-links { font-size: 8.5pt; margin: 6pt 0 0; }
.node-children-links a { color: #3d6ef5; text-decoration: underline; }
</style>
</head>
<body>

<header class="doc-header">
  <h1>{{ site.title }}</h1>
</header>

<main>{{ m::node(n=site.root) }}</main>

</body>
</html>
